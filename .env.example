# Copy to .env and fill in.
# Platform-state database (local dev uses the Postgres started in the VM).
DATABASE_URL="postgresql://buildmint:buildmint@localhost:5432/buildmint?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me"

# --- Optional integrations for later phases (not required to run Phase 1) ---
# OPENAI_API_KEY=""            # Phase 4: AI audit background service
# ANTHROPIC_API_KEY=""         # Phase 4: alternative LLM provider
# INNGEST_EVENT_KEY=""         # Phase 4: background job runner
# INNGEST_SIGNING_KEY=""
# RESEND_API_KEY=""            # Phase 5: daily notification emails
